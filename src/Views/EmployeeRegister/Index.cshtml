@model List<csharp_training_202605.Applications.Domains.Employee>

@{
    ViewData["Title"] = "従業員一覧";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>
<div class="container mt-4">
    <div class="row justify-content-center">

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">従業員が登録されていません。</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>社員Id</th>
                            <th>氏名</th>
                            <th>メールアドレス</th>
                            <th>部署</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <td>@employee.Id</td>
                                <td>@employee.Name</td>
                                <td>@employee.Email</td>
                                <td>@employee.Department?.Name </td>
                            </tr>
                        }

                    </tbody>
                </table>
                <div class="text-center">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary mt-3 ms-2">
                        メニューに戻る
                    </a>
                </div>
            </div>
        }
