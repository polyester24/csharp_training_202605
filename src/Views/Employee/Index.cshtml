@model List<csharp_training_202605.Applications.Domains.Employee>

@{
    ViewData["Title"] = "従業員一覧";
}

<h1>従業員一覧</h1>

<p>
    <a asp-controller="EmployeeRegister" asp-action="Enter" class="btn btn-primary">従業員登録</a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">従業員が登録されていません。</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-light">
                <tr>
                    <th>社員Id</th>
                    <th>氏名</th>
                    <th>メールアドレス</th>
                    <th>部署</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                        <td>@employee.Id</td>
                        <td>@employee.Name</td>
                        <td>@employee.Email</td>
                        <td>@employee.Department?.Name ?? "未配属"</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
