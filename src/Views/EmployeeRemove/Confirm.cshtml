@model csharp_training_202605.Presentations.ViewModels.EmployeeRemoveViewModel

@{
    ViewData["Title"] = "従業員削除確認";
}

<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="row justify-content-center">

        <div class="alert alert-info">
            以下の部署を削除します。よろしいですか？
        </div>

        <table class="table table-borderless">
            <tr>
                <th style="width: 200px;">部署名</th>
                <td>@Model.Name</td>
            </tr>
        </table>

        <form asp-action="Remove" asp-controller="EmployeeRemove" method="post">
            <input type="hidden" asp-for="Name" />
            <div class="text-center">
                <button type="submit" class="btn btn-primary">削除</button>
                <a asp-action="Enter" class="btn btn-secondary ms-2">戻る</a>
            </form>
