@model csharp_training_202605.Presentations.ViewModels.DepartmentRegisterViewModel

@{
    ViewData["Title"] = "部署登録確認";
}

<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="row justify-content-center">

        
        <div class="alert alert-info">
            以下の内容で部署を登録します。よろしいですか？
        </div>

        <table class="table table-borderless">
            <tr>
                <th style="width: 200px;">部署名</th>
                <td>@Model.Name</td>
            </tr>
        </table>

        <form asp-action="Register" asp-controller="DepartmentRegister" method="post">
            <input type="hidden" asp-for="Name" />
            <div class="text-center mt-4">
                <button type="submit" formaction="@Url.Action("Register", "DepartmentRegister")" formmethod="post"
                        class="btn btn-primary">登録</button>
                <button type="submit" formaction="@Url.Action("Back", "DepartmentRegister")" formmethod="post"
                        class="btn btn-secondary">戻る</button>
            </div>
        </form>
    </div>
</div>
