@using csharp_training_202605.Presentations.ViewModels
@model DepartmentRegisterViewModel

@{
    ViewData["Title"] = "部署登録(入力)";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-4 col-sm-6">
            <form asp-action="Confirm" asp-controller="DepartmentRegister" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary">確認</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">一覧へ</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
